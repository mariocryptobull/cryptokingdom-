[
 {
  "t0": 0.56,
  "t1": 2.675,
  "text": "Every electric train is a chain."
 },
 {
  "t0": 2.655,
  "t1": 3.647,
  "text": "Pull it apart,"
 },
 {
  "t0": 3.627,
  "t1": 5.838,
  "text": "and you can see every link."
 },
 {
  "t0": 6.16,
  "t1": 7.842,
  "text": "Up top, the catenary."
 },
 {
  "t0": 7.822,
  "t1": 10.242,
  "text": "Between New Haven and Boston,"
 },
 {
  "t0": 10.222,
  "t1": 12.64,
  "text": "it carries 25,000 volts."
 },
 {
  "t0": 12.66,
  "t1": 14.369,
  "text": "A spring-loaded pantograph"
 },
 {
  "t0": 14.349,
  "t1": 15.923,
  "text": "presses against the wire"
 },
 {
  "t0": 15.903,
  "t1": 17.947,
  "text": "and pulls that power down."
 },
 {
  "t0": 18.06,
  "t1": 19.513,
  "text": "Inside, a transformer"
 },
 {
  "t0": 19.493,
  "t1": 20.445,
  "text": "steps it down,"
 },
 {
  "t0": 20.425,
  "t1": 22.093,
  "text": "and a traction converter"
 },
 {
  "t0": 22.073,
  "t1": 24.24,
  "text": "reshapes it for the motors."
 },
 {
  "t0": 24.26,
  "t1": 25.794,
  "text": "The motors drive the axles"
 },
 {
  "t0": 25.774,
  "t1": 27.147,
  "text": "through gears."
 },
 {
  "t0": 27.76,
  "t1": 29.011,
  "text": "Now the clever part."
 },
 {
  "t0": 28.991,
  "t1": 30.38,
  "text": "The wheels aren't flat."
 },
 {
  "t0": 30.36,
  "t1": 31.739,
  "text": "They're cones."
 },
 {
  "t0": 31.86,
  "t1": 32.632,
  "text": "On a curve,"
 },
 {
  "t0": 32.612,
  "t1": 34.588,
  "text": "the wheelset slides outward,"
 },
 {
  "t0": 34.568,
  "t1": 36.242,
  "text": "so the outer wheel rolls"
 },
 {
  "t0": 36.222,
  "t1": 37.671,
  "text": "on a bigger diameter."
 },
 {
  "t0": 37.651,
  "t1": 39.796,
  "text": "The train steers itself."
 },
 {
  "t0": 39.96,
  "t1": 41.147,
  "text": "And when it brakes,"
 },
 {
  "t0": 41.127,
  "t1": 43.001,
  "text": "the motors become generators,"
 },
 {
  "t0": 42.981,
  "t1": 44.776,
  "text": "sending energy back."
 },
 {
  "t0": 45.16,
  "t1": 46.298,
  "text": "Above all of it:"
 },
 {
  "t0": 46.278,
  "t1": 48.054,
  "text": "positive train control."
 },
 {
  "t0": 48.034,
  "t1": 48.853,
  "text": "GPS, radio,"
 },
 {
  "t0": 48.833,
  "t1": 50.529,
  "text": "and onboard computers"
 },
 {
  "t0": 50.509,
  "t1": 52.206,
  "text": "that can stop the train"
 },
 {
  "t0": 52.186,
  "t1": 53.634,
  "text": "on their own."
 },
 {
  "t0": 53.76,
  "t1": 56.316,
  "text": "Required by law since 2008."
 },
 {
  "t0": 56.296,
  "t1": 58.957,
  "text": "Live on every mandated line"
 },
 {
  "t0": 58.937,
  "t1": 61.117,
  "text": "by the end of 2020."
 },
 {
  "t0": 61.56,
  "t1": 62.827,
  "text": "Wire. Wheel. Signal."
 },
 {
  "t0": 62.807,
  "t1": 64.25,
  "text": "That's a train."
 }
]